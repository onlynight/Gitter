{
  "schemaVersion": 2,
  "id": "gitui.page.files",
  "name": "内置页面：项目文件树",
  "version": "0.2.0",
  "description": "Gitter 内置页面（宿主缺省提供者，不可卸载、可被同槽位插件替换）——项目文件树 + Monaco 代码编辑器，支持手动编辑与 git 状态/agent 回合高亮。重资产走 GITTER_LIBS 依赖库：Monaco（gitui.lib.monaco）与 Office 预览运行时（gitui.page.office/officeview）由 loader 按声明先行注入",
  "contributes": {
    "pages": [
      {
        "id": "files",
        "slot": "files",
        "title": "%Nav_Files%",
        "entry": "page.js",
        "icon": "",
        "svg": "M1.5 4.25C1.5 3.28 2.28 2.5 3.25 2.5h3.4c.5 0 .98.22 1.31.6l.99 1.15h4.8c.97 0 1.75.78 1.75 1.75v6.75c0 .97-.78 1.75-1.75 1.75H3.25c-.97 0-1.75-.78-1.75-1.75z",
        "lazy": true,
        "permissions": [
          "git.read",
          "git.write",
          "window",
          "lsp"
        ],
        "docs": {
          "zh-Hans": "docs/zh-Hans.md"
        },
        "dependencies": [
          {
            "lib": "monaco-nls-zh-cn",
            "package": "lang.monaco.zhcn",
            "required": false
          },
          {
            "lib": "monaco",
            "package": "gitui.lib.monaco",
            "semver": "^0.52.0"
          },
          {
            "lib": "officeview",
            "package": "gitui.page.office"
          },
          {
            "lib": "chart",
            "package": "gitui.lib.chart",
            "required": false
          }
        ]
      }
    ]
  }
}
