{
  "schemaVersion": 2,
  "id": "tools.gitui.git",
  "name": "Git 维护工具",
  "version": "1.0.0",
  "description": "常用仓库维护命令（L1 受限命令，在当前仓库终端执行）",
  "contributes": {
    "commands": [
      {
        "id": "count",
        "title": "统计提交数量 (rev-list --count)",
        "when": "repoOpen",
        "action": "terminal.run",
        "args": {
          "command": "git rev-list --count HEAD"
        }
      },
      {
        "id": "prune",
        "title": "Fetch 并清理失效远程分支 (--prune)",
        "when": "repoOpen",
        "action": "terminal.run",
        "args": {
          "command": "git fetch --prune"
        }
      },
      {
        "id": "gc",
        "title": "Git GC（仓库瘦身，大仓库可能耗时）",
        "when": "repoOpen",
        "action": "terminal.run",
        "args": {
          "command": "git gc"
        }
      }
    ]
  }
}
