<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GitUI.Diff</RootNamespace>
    <AssemblyName>GitUI.Diff</AssemblyName>
  </PropertyGroup>

  <!--
    依赖约束（design.md §8 S2）：Diff 引擎是纯算法层，不得引用 libgit2sharp，
    也不得引用 GitUI.Git。由 GitUI.Diff.Tests/DependencyCheckTests 自动验证。
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="GitUI.Diff.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitUI.Core\GitUI.Core.csproj" />
  </ItemGroup>

</Project>
