{
  "highlighters": [
    {
      "id": "builtin.csharp",
      "language": "csharp",
      "extensions": [
        ".cs",
        ".csx"
      ],
      "rules": [
        {
          "style": "comment",
          "pattern": "//.*$"
        },
        {
          "style": "string",
          "pattern": "\\\"(?:\\.|[^\\\"\\])*\\\""
        },
        {
          "style": "string",
          "pattern": "'(?:\\.|[^'\\])'"
        },
        {
          "style": "keyword",
          "keywords": [
            "abstract",
            "as",
            "async",
            "await",
            "base",
            "bool",
            "break",
            "byte",
            "case",
            "catch",
            "char",
            "checked",
            "class",
            "const",
            "continue",
            "decimal",
            "default",
            "delegate",
            "do",
            "double",
            "else",
            "enum",
            "event",
            "explicit",
            "extern",
            "false",
            "finally",
            "fixed",
            "float",
            "for",
            "foreach",
            "get",
            "goto",
            "if",
            "implicit",
            "in",
            "init",
            "int",
            "interface",
            "internal",
            "is",
            "lock",
            "long",
            "namespace",
            "new",
            "null",
            "object",
            "operator",
            "out",
            "override",
            "params",
            "private",
            "protected",
            "public",
            "readonly",
            "record",
            "ref",
            "return",
            "sealed",
            "set",
            "short",
            "sizeof",
            "stackalloc",
            "static",
            "string",
            "struct",
            "switch",
            "this",
            "throw",
            "true",
            "try",
            "typeof",
            "uint",
            "ulong",
            "unchecked",
            "unsafe",
            "ushort",
            "using",
            "var",
            "virtual",
            "void",
            "volatile",
            "when",
            "where",
            "while"
          ]
        },
        {
          "style": "number",
          "pattern": "\\b0x[0-9A-Fa-f]+\\b|\\b\\d+(?:\\.\\d+)?[fFdDmMuUlL]*\\b"
        },
        {
          "style": "type",
          "pattern": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    {
      "id": "builtin.json",
      "language": "json",
      "extensions": [
        ".json",
        ".jsonc"
      ],
      "rules": [
        {
          "style": "string",
          "pattern": "\\\"(?:\\.|[^\\\"\\])*\\\""
        },
        {
          "style": "keyword",
          "pattern": "\\b(?:true|false|null)\\b"
        },
        {
          "style": "number",
          "pattern": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    {
      "id": "builtin.powershell",
      "language": "powershell",
      "extensions": [
        ".ps1",
        ".psm1",
        ".psd1"
      ],
      "rules": [
        {
          "style": "comment",
          "pattern": "#.*$"
        },
        {
          "style": "string",
          "pattern": "\\\"[^\\\"]*\\\""
        },
        {
          "style": "string",
          "pattern": "'[^']*'"
        },
        {
          "style": "variable",
          "pattern": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "style": "keyword",
          "keywords": [
            "if",
            "elseif",
            "else",
            "foreach",
            "for",
            "while",
            "switch",
            "return",
            "function",
            "filter",
            "param",
            "begin",
            "process",
            "end",
            "try",
            "catch",
            "finally",
            "throw",
            "break",
            "continue",
            "in",
            "do",
            "until",
            "trap",
            "class",
            "enum"
          ]
        },
        {
          "style": "number",
          "pattern": "\\b0x[0-9A-Fa-f]+\\b|\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    {
      "id": "builtin.markdown",
      "language": "markdown",
      "extensions": [
        ".md",
        ".markdown"
      ],
      "rules": [
        {
          "style": "string",
          "pattern": "`[^`]+`"
        },
        {
          "style": "type",
          "pattern": "\\*\\*[^*]+\\*\\*"
        },
        {
          "style": "variable",
          "pattern": "\\[[^\\]]*\\]\\([^)]*\\)"
        },
        {
          "style": "keyword",
          "pattern": "^#{1,6} .*$"
        }
      ]
    },
    {
      "id": "builtin.xml",
      "language": "xml",
      "extensions": [
        ".xml",
        ".xaml",
        ".csproj",
        ".props",
        ".targets",
        ".config"
      ],
      "rules": [
        {
          "style": "comment",
          "pattern": "<!--.*?(?:-->|$)"
        },
        {
          "style": "type",
          "pattern": "</?[A-Za-z][A-Za-z0-9:.-]*|/?>"
        },
        {
          "style": "string",
          "pattern": "\\\"[^\\\"]*\\\""
        }
      ]
    }
  ]
}