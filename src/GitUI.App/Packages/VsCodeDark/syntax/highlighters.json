{
  "highlighters": [
    {
      "id": "vscode.csharp",
      "language": "csharp",
      "extensions": [
        ".cs",
        ".csx"
      ],
      "rules": [
        {
          "style": "comment",
          "blockStart": "/\\*",
          "blockEnd": "\\*/"
        },
        {
          "style": "comment",
          "pattern": "//.*$"
        },
        {
          "style": "keyword",
          "pattern": "^\\s*#\\w+.*$"
        },
        {
          "style": "string",
          "pattern": "(?:\\$@|@\\$)?@\\\"(?:\\\"\\\"|[^\\\"])*\\\""
        },
        {
          "style": "string",
          "pattern": "\\$\\\"(?:\\.|[^\\\"\\])*\\\""
        },
        {
          "style": "string",
          "pattern": "\\\"(?:\\.|[^\\\"\\])*\\\""
        },
        {
          "style": "string",
          "pattern": "'(?:\\.|[^'\\])'"
        },
        {
          "style": "keyword",
          "keywords": [
            "abstract",
            "as",
            "async",
            "await",
            "base",
            "break",
            "case",
            "catch",
            "checked",
            "class",
            "const",
            "continue",
            "default",
            "delegate",
            "do",
            "else",
            "enum",
            "event",
            "explicit",
            "extern",
            "false",
            "finally",
            "fixed",
            "for",
            "foreach",
            "get",
            "goto",
            "if",
            "implicit",
            "in",
            "init",
            "interface",
            "internal",
            "is",
            "lock",
            "namespace",
            "new",
            "null",
            "operator",
            "out",
            "override",
            "params",
            "partial",
            "private",
            "protected",
            "public",
            "readonly",
            "record",
            "ref",
            "required",
            "sealed",
            "set",
            "sizeof",
            "stackalloc",
            "static",
            "struct",
            "switch",
            "this",
            "throw",
            "true",
            "try",
            "typeof",
            "unchecked",
            "unsafe",
            "using",
            "virtual",
            "volatile",
            "when",
            "where",
            "while",
            "add",
            "global",
            "removing",
            "yield",
            "value",
            "file",
            "scoped",
            "bool",
            "byte",
            "char",
            "decimal",
            "double",
            "dynamic",
            "float",
            "int",
            "long",
            "nint",
            "nuint",
            "object",
            "sbyte",
            "short",
            "string",
            "uint",
            "ulong",
            "ushort",
            "void",
            "var"
          ]
        },
        {
          "style": "function",
          "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "style": "number",
          "pattern": "\\b(?:0[xX][0-9A-Fa-f_]+|\\d[\\d_]*(?:\\.[\\d_]+)?(?:[eE][+-]?\\d+)?)[fFdDmMuUlL]*\\b"
        },
        {
          "style": "type",
          "pattern": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  ]
}