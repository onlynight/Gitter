<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>GitUI.App</RootNamespace>
    <AssemblyName>GitUI.App</AssemblyName>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- S7 发布：Release 构建自包含（含 WinApp SDK），Debug 保持依赖已安装运行时（F5 快）。
         不能经 -p: 全局传入——属性流到类库会触发 WindowsAppSDKSelfContained guard 报错 -->
    <WindowsAppSDKSelfContained Condition="'$(Configuration)' == 'Release'">true</WindowsAppSDKSelfContained>
    <PublishWindowsAppPackage>false</PublishWindowsAppPackage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- GitUI.Controls 引入 Win2D（原生 dll 按 RID 解析）；RID 固定 x64，输出路径形状不变 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitUI.Core\GitUI.Core.csproj" />
    <ProjectReference Include="..\GitUI.Git\GitUI.Git.csproj" />
    <ProjectReference Include="..\GitUI.Shell\GitUI.Shell.csproj" />
    <ProjectReference Include="..\GitUI.Controls\GitUI.Controls.csproj" />
    <ProjectReference Include="..\GitUI.ViewModels\GitUI.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- S0e/P3：终端宿主二进制随应用分发（winpty 兜底 + OpenConsole 预留，MIT） -->
    <Content Include="pty\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 确保 XAML 编译产物被复制到发布目录 -->
  <Target Name="CopyXamlArtifactsToPublish" BeforeTargets="Publish">
    <ItemGroup>
      <XamlArtifact Include="$(IntermediateOutputPath)**\*.xbf" />
      <XamlArtifact Include="$(OutputPath)\$(AssemblyName).pri" Condition="Exists('$(OutputPath)\$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlArtifact)" DestinationFiles="@(XamlArtifact->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
