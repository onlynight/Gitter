<UserControl
    x:Class="GitUI.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
        <StackPanel Spacing="16" Margin="24">
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="主题" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="基座" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="ThemeSystemBtn" Content="跟随系统" Padding="12,6" CornerRadius="6" Click="Theme_Click"/>
                        <controls:Button x:Name="ThemeLightBtn" Content="浅色" Padding="12,6" CornerRadius="6" Click="Theme_Click"/>
                        <controls:Button x:Name="ThemeDarkBtn" Content="深色" Padding="12,6" CornerRadius="6" Click="Theme_Click"/>
                    </StackPanel>
                    <TextBlock Text="主题包" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="ThemePackageList" Spacing="2"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="ThemeFollowBaseBtn" Content="跟随基座（内置）" Padding="12,6" CornerRadius="6" Click="ThemeFollowBase_Click"/>
                        <controls:Button x:Name="ImportThemeBtn" Content="导入主题包 .gpk…" Padding="12,6" CornerRadius="6" Click="ImportTheme_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ThemeStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="扩展" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="按种类启用/禁用扩展包（主题 / 语法高亮）；卸载仅对自定义包可用。" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="ExtensionPackageList" Spacing="2"/>
                    <TextBlock x:Name="ExtensionStatusText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Diff 模式" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="DiffSideBySideBtn" Content="并排" Padding="12,6" CornerRadius="6" Click="DiffMode_Click"/>
                        <controls:Button x:Name="DiffInlineBtn" Content="内联" Padding="12,6" CornerRadius="6" Click="DiffMode_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="开发工具" FontSize="13" FontWeight="SemiBold"/>
                    <controls:Button x:Name="DiffPreviewBtn" Content="打开 Diff 渲染预览（S3 验证）" Padding="12,6" CornerRadius="6" Click="DiffPreview_Click"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="设置文件" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="ExportBtn" Content="导出到文件…" Padding="12,6" CornerRadius="6" Click="Export_Click"/>
                        <controls:Button x:Name="ImportBtn" Content="从文件导入…" Padding="12,6" CornerRadius="6" Click="Import_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
