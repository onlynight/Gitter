<UserControl
    x:Class="GitUI.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid Margin="24">
        <StackPanel Spacing="16">
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
            <Border Background="#FF303030" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="主题" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="ThemeSystemBtn" Content="跟随系统" Padding="12,6" CornerRadius="6" Click="Theme_Click"/>
                        <controls:Button x:Name="ThemeLightBtn" Content="浅色" Padding="12,6" CornerRadius="6" Click="Theme_Click"/>
                        <controls:Button x:Name="ThemeDarkBtn" Content="深色" Padding="12,6" CornerRadius="6" Click="Theme_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#FF303030" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Diff 模式" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="DiffSideBySideBtn" Content="并排" Padding="12,6" CornerRadius="6" Click="DiffMode_Click"/>
                        <controls:Button x:Name="DiffInlineBtn" Content="内联" Padding="12,6" CornerRadius="6" Click="DiffMode_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#FF303030" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="开发工具" FontSize="13" FontWeight="SemiBold"/>
                    <controls:Button x:Name="DiffPreviewBtn" Content="打开 Diff 渲染预览（S3 验证）" Padding="12,6" CornerRadius="6" Click="DiffPreview_Click"/>
                </StackPanel>
            </Border>
            <Border Background="#FF303030" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="设置文件" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Button x:Name="ExportBtn" Content="导出到文件…" Padding="12,6" CornerRadius="6" Click="Export_Click"/>
                        <controls:Button x:Name="ImportBtn" Content="从文件导入…" Padding="12,6" CornerRadius="6" Click="Import_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
