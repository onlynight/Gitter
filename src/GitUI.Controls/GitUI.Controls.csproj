<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>GitUI.Controls</RootNamespace>
    <AssemblyName>GitUI.Controls</AssemblyName>
    <Version>0.0.1</Version>
    <!-- Win2D 的原生 dll 按 RID 解析（AnyCPU 构建下不可引用）；RID 固定 x64，
         AppendRuntimeIdentifierToOutputPath=false 保持输出路径形状不变 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitUI.Core\GitUI.Core.csproj" />
    <ProjectReference Include="..\GitUI.Diff\GitUI.Diff.csproj" />
  </ItemGroup>

</Project>
