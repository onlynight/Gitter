<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GitUI.Core</RootNamespace>
    <AssemblyName>GitUI.Core</AssemblyName>
    <!-- 中性语言 = 英文（docs/i18n.md）：zh-Hans 走卫星程序集，其余文化回退英文 -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitUI.Core.Tests" />
  </ItemGroup>

</Project>
