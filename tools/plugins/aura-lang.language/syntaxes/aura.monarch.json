    "box",
    "weak",
    "malloc",
    "free",
    "retain",
    "release",
    "value",
    "expect",
    "actual"
  ],
  "builtinTypes": [
    "Any",
    "Nothing",
    "Unit",
    "Int",
    "Long",
    "Short",
    "Byte",
    "Char",
    "Float",
    "Double",
    "Boolean",
    "String",
    "CharSequence",
    "StringBuilder",
    "List",
    "MutableList",
    "Set",
    "MutableSet",
    "Map",
    "MutableMap",
    "IntArray",
    "LongArray",
    "DoubleArray",
    "FloatArray",
    "ByteArray",
    "CharArray",
    "Comparable",
    "Iterable",
    "Sequence",
    "Pair",
    "Triple",
    "Range",
    "Lazy",
    "Throwable",
    "Exception",
    "Error",
    "Actor",
    "Job"
  ],
  "operators": [
    "+",
    "-",
    "*",
    "/",
    "%",
    "=",
    "==",
    "===",
    "!",
    "!=",
    "!==",
    "++",
    "--",
    "&&",
    "||",
    "->",
    "..",
    "as",
    "as?",
    "!!",
    "?.",
    "?:",
    "::",
    "@",
    ":",
    ";",
    ".",
    "(",
    ")",
    "{",
    "}",
    "[",
    "]",
    "<",
    ">",
    "|",
    "&",
    "^",
    "~",
    "<<",
    ">>",
    "<<=",
    ">>=",
    "+=",
    "-=",
    "*=",
    "/=",
    "%="
  ],
  "symbols": "[=><!~?:&|+\\-*\\/\\^%]+",
  "escapes": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
  "digits": "\\d+(_+\\d+)*",
  "octalDigits": "[0-7]+(_+[0-7]+)*",
  "binaryDigits": "[0-1]+(_+[0-1]+)*",
  "hexDigits": "[0-9a-fA-F]+(_+[0-9a-fA-F]+)*",
  "tokenizer": {
    "root": [
      [
        "[A-Z][\\w$]*",
        "type.identifier"
      ],
      [
        "[a-zA-Z_$][\\w$]*",
        {
          "cases": {
            "@keywords": "keyword",
            "@builtinTypes": "type.builtin",
            "@default": "identifier"
          }
        }
      ],
      {
        "include": "@whitespace"
      },
      [
        "[{}()\\[\\]]",
        "@brackets"
      ],
      [
        "<(?![>=])",
        "@brackets"
      ],
      [
        "@symbols",
        {
          "cases": {
            "@operators": "delimiter",
            "@default": ""
          }
        }
      ],
      [
        "@\\s*[a-zA-Z_$][\\w$]*(?=\\s*\\()",
        "annotation",
        "@annotationArgs"
      ],
      [
        "@\\s*[a-zA-Z_$][\\w$]*",
        "annotation"
      ],
      [
        "\\w@",
        "label"
      ],
      [
        "0x[0-9a-fA-F]+[Ll]?",
        "number.hex"
      ],
      [
        "0b[01]+[Ll]?",
        "number.binary"
      ],
      [
        "0o[0-7]+[Ll]?",
        "number.octal"
      ],
      [
        "(@digits)\\.(@digits)([eE][\\-+]?(@digits))?[fFdD]?",
        "number.float"
      ],
      [
        "(@digits)([eE][\\-+]?(@digits))?[fFdD]?",
        "number.float"
      ],
      [
        "(@digits)[Ll]?",
        "number"
      ],
      [
        "[;,.]",
        "delimiter"
      ],
      [
        "\"\"\"",
        "string",
        "@rawString"
      ],
      [
        "\"",
        "string",
        "@string"
      ],
      [
        "`[^`\\\\]*(?:\\\\.[^`\\\\]*)*`",
        "string.escape"
      ],
      [
        "'[^\\\\']'",
        "string.char"
      ],
      [
        "(')(@escapes)(')",
        [
          "string.char",
          "string.escape",
          "string.char"
        ]
      ],
      [
        "'",
        "string.invalid"
      ]
    ],
    "whitespace": [
      [
        "[ \\t\\r\\n]+",
        ""
      ],
      [
        "\\/\\*\\*(?!\\/)",
        "comment.doc",
        "@javadoc"
      ],
      [
        "\\/\\*",
        "comment",
        "@comment"
      ],
      [
        "\\/\\/.*$",
        "comment"
      ]
    ],
    "comment": [
      [
        "[^\\/*]+",
        "comment"
      ],
      [
        "\\/\\*",
        "comment",
        "@comment"
      ],
      [
        "\\*\\/\\s*$",
        ""
      ],
      [
        "\\*\\/\\s*([^\\s*]+[^\\s]*)",
        ""
      ],
      [
        "\\*\\/\\s*",
        "comment",
        "@pop"
      ],
      [
        "\\*",
        "comment"
      ],
      [
        "[\\s\\S]",
        "comment"
      ]
    ],
    "javadoc": [
      [
        "[^\\/*]+",
        "comment.doc"
      ],
      [
        "\\/\\*",
        "comment.doc",
        "@push"
      ],
      [
        "\\/\\*",
        "comment.doc.invalid"
      ],
      [
        "\\*\\/\\s*$",
        ""
      ],
      [
        "\\*\\/\\s*([^\\s*]+[^\\s]*)",
        ""
      ],
      [
        "\\*\\/\\s*",
        "comment.doc",
        "@pop"
      ],
      [
        "\\*",
        "comment.doc"
      ],
      [
        "[\\s\\S]",
        "comment.doc"
      ],
      [
        "@\\w+",
        "annotation"
      ]
    ],
    "string": [
      [
        "\\$\\{[^}]+\\}",
        {
          "cases": {
            "@default": "string.interp"
          }
        }
      ],
      [
        "\\$[A-Za-z_][\\w]*",
        "string.interp"
      ],
      [
        "[^\\\\$\"]+",
        "string"
      ],
      [
        "@escapes",
        "string.escape"
      ],
      [
        "\\\\.",
        "string.escape.invalid"
      ],
      [
        "\"",
        "string",
        "@pop"
      ]
    ],
    "rawString": [
      [
        "\"\"\"",
        "string",
        "@pop"
      ],
      [
        "[^\"]+",
        "string"
      ],
      [
        ".",
        "string"
      ]
    ],
    "annotationArgs": [
      [
        "\\(",
        "delimiter",
        "@push"
      ],
      [
        "\\)",
        "delimiter",
        "@pop"
      ],
      [
        "@escapes",
        "string.escape"
      ],
      {
        "include": "@root"
      }
    ]
  }
}
